{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/optimize-images.mjs && astro build && node scripts/prune-dist-images.mjs && node scripts/finalize-sitemap.mjs && node scripts/indexnow.mjs",
    "build:i18n-test": "node scripts/optimize-images.mjs && astro build && node scripts/prune-dist-images.mjs && node scripts/finalize-sitemap.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "start": "node scripts/serve.mjs",
    "astro": "astro",
    "optimize:images": "node scripts/optimize-images.mjs",
    "generate:brand": "node scripts/generate-brand-icons.mjs",
    "translate": "node scripts/translate.mjs",
    "translate:forum": "node scripts/translate.mjs --forum",
    "translate:refresh-en": "npm run i18n:export-en && node scripts/translate.mjs",
    "i18n:export-en": "tsx scripts/export-i18n-en.mjs",
    "i18n:export-forum": "tsx scripts/export-forum-en.mjs",
    "i18n:export-product": "tsx scripts/export-product-locale-en.mjs",
    "check:seo": "node scripts/check-keywords.mjs && node scripts/check-blog-seo.mjs",
    "check:links": "node scripts/check-i18n-links.mjs",
    "verify": "node scripts/verify-site.mjs",
    "qa": "npm run build:i18n-test && npm run check:seo && npm run verify"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.48.0",
    "@starwind-ui/astro": "^1.2.1",
    "@tabler/icons": "^3.48.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "dotenv": "^18.0.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
