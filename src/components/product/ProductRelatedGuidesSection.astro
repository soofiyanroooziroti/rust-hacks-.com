---
import type { BlogPost } from '../../i18n/types';
import SectionHeader from '../SectionHeader.astro';
import BlogCard from '../BlogCard.astro';
import { Button } from '@/components/starwind/button';
import Icon from '../icons/Icon.astro';
import { getLocaleFromAstro, getTranslations } from '../../i18n';
import { localizedPath, ROUTES } from '../../utils/path';

interface Props {
  posts: BlogPost[];
  productName: string;
}

const locale = getLocaleFromAstro(Astro);
const t = getTranslations(locale);
const { posts, productName } = Astro.props;
const blogHref = localizedPath(ROUTES.blog, locale);
---

{
  posts.length > 0 && (
    <section class="border-t border-border bg-muted/20 py-16 md:py-24" aria-labelledby="related-guides-heading">
      <div class="mx-auto max-w-6xl px-5">
        <SectionHeader
          eyebrow={t.catalog?.guidesEyebrow ?? 'Guides'}
          title={(t.catalog?.learnMore ?? 'Learn more about {name}').replace('{name}', productName)}
          desc={t.catalog?.guidesDesc ?? 'Curated articles for setup, tuning, and patch-day checks that match this product.'}
          titleId="related-guides-heading"
        />

        <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-y-10">
          {posts.map((post, i) => (
            <BlogCard post={post} index={i} showDate />
          ))}
        </div>

        <div class="mt-12 flex justify-start lg:justify-center">
          <Button as="a" href={blogHref} variant="outline" class="rounded-full">
            {t.blog.viewAll}
            <Icon name="arrowRight" size={17} />
          </Button>
        </div>
      </div>
    </section>
  )
}
