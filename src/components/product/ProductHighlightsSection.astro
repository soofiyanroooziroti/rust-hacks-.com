---
import { getLocaleFromAstro, getTranslations } from '../../i18n';
const locale = getLocaleFromAstro(Astro);
const t = getTranslations(locale);
import type { ProductPage } from '../../data/products';
import SectionHeader from '../SectionHeader.astro';
import Icon from '../icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { Badge } from '@/components/starwind/badge';

interface Props {
  product: ProductPage;
}

const { product } = Astro.props;
---

<section
  class="border-b border-border bg-muted/20 py-12 md:py-16"
  aria-labelledby="product-highlights-title"
>
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader
      eyebrow={t.catalog?.atAGlance ?? 'At a glance'}
      title={t.catalog?.keyCapabilities ?? 'Key capabilities'}
      desc={(t.catalog?.focusesBefore ?? 'What {name} focuses on before you open the full module list.').replace('{name}', product.name)}
      titleId="product-highlights-title"
    />

    <div class="product-detail__inline-row mt-10 flex flex-wrap gap-2.5 md:gap-3">
      {
        product.features.map((feature) => (
          <Badge variant="outline" size="lg" class="rounded-full px-4 py-2 text-sm font-medium leading-snug">
            {feature}
          </Badge>
        ))
      }
    </div>

    {
      product.more > 0 && product.slug !== 'rust-cheat' && (
        <p class="product-detail__text-center mt-6 text-sm text-muted-foreground">
          {(t.catalog?.moreModules ?? 'Plus {count} additional modules in the operator portal—see the full list below.').replace('{count}', String(product.more))}
        </p>
      )
    }

    <div
      class:list={[
        'product-detail__inline-row flex flex-wrap gap-3',
        product.slug === 'rust-cheat' || product.more <= 0 ? 'mt-10' : 'mt-8',
      ]}
    >
      <Button type="button" data-scroll-target="features" variant="outline" size="sm" class="rounded-full">
        {t.catalog?.allModules ?? 'All modules'}
        <Icon name="chevronDown" size={16} />
      </Button>
      <Button as="a" href={product.buyUrl} variant="primary" size="sm" class="rounded-full" rel="sponsored nofollow noopener" data-astro-reload data-astro-prefetch="false">
        {t.catalog?.buyNow ?? 'Buy now'}
        <Icon name="arrowRight" size={16} />
      </Button>
    </div>
  </div>
</section>
