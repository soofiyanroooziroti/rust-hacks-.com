---
import { getLocaleFromAstro, getTranslations } from '../i18n';
import { productPath } from '../utils/path';
const locale = getLocaleFromAstro(Astro);
const t = getTranslations(locale);
import { featureIcons } from '../data/sectionIcons';
import SectionHeader from './SectionHeader.astro';
import Icon from './icons/Icon.astro';
import SlideRevealButton from './SlideRevealButton.astro';

const s = t.features;
const featuresHref = `${productPath('rust-cheat', locale)}#features`;
const seeAllLabel = (s as { seeAllLabel?: string }).seeAllLabel ?? 'See all features';
---

<section id="features" class="border-y border-border bg-muted/20 py-12 md:py-16" aria-labelledby="features-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader eyebrow={s.eyebrow} title={s.title} desc={s.subtitle} titleId="features-title" />

    <ul
      class="mt-8 grid grid-cols-2 gap-2 sm:grid-cols-3 sm:gap-2.5 lg:grid-cols-3 lg:gap-3"
      role="list"
    >
      {
        s.items.map((item) => (
          <li>
            <article class="feature-category-card flex items-center gap-2.5 rounded-lg border border-border bg-card px-3 py-2.5 shadow-sm transition-colors hover:border-primary/35">
              <span class="flex size-8 shrink-0 items-center justify-center rounded-md bg-primary/10">
                <Icon name={featureIcons[item.title] ?? 'crosshair'} size={16} />
              </span>
              <h3 class="min-w-0 text-xs font-semibold leading-snug text-foreground sm:text-sm">{item.title}</h3>
            </article>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 flex justify-center sm:justify-start">
      <SlideRevealButton href={featuresHref}>{seeAllLabel}</SlideRevealButton>
    </div>
  </div>
</section>
