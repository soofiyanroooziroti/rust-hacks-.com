---
import { getLocaleFromAstro, getTranslations } from '../i18n';
const locale = getLocaleFromAstro(Astro);
const t = getTranslations(locale);
import { getFeaturedBlogPosts } from '../data/blog';
import SectionHeader from './SectionHeader.astro';
import BlogCard from './BlogCard.astro';
import Icon from './icons/Icon.astro';
import { localizedPath, ROUTES } from '../utils/path';
import SiteFaqSection from './SiteFaqSection.astro';
import { getLandingFaqs } from '../data/faq-locale';
import { Button } from '@/components/starwind/button';

const homeFaqs = getLandingFaqs(locale);
const featuredPosts = getFeaturedBlogPosts(3, locale);
const blogHref = localizedPath(ROUTES.blog, locale);
---

{
  featuredPosts.length > 0 && (
    <section id="blog" class="border-y border-border bg-muted/20 py-16 md:py-24" aria-labelledby="blog-title">
      <div class="mx-auto max-w-6xl px-5">
        <SectionHeader eyebrow={t.blog.eyebrow} title={t.blog.title} desc={t.blog.subtitle} titleId="blog-title" />

        <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-y-10">
          {featuredPosts.map((post, i) => (
            <BlogCard post={post} index={i} />
          ))}
        </div>

        <div class="mt-10 flex justify-start lg:justify-center">
          <Button as="a" href={blogHref} variant="outline">
            {t.blog.viewAll}
            <Icon name="arrowRight" size={17} />
          </Button>
        </div>
      </div>
    </section>
  )
}

<SiteFaqSection id="faq" titleId="faq-title" items={homeFaqs} />
