---
import '@/styles/site-fonts.css';
import '@/styles/starwind.css';
import {
  getAlternateLanguages,
  getLocaleFromAstro,
  getTranslations,
  localeMeta,
  localePath,
} from '../i18n';
import type { Locale } from '../i18n/locales';
import {
  RSS_FEED_PATH,
  TWITTER_CREATOR,
  TWITTER_SITE,
  canonicalUrl,
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_HEIGHT,
  DEFAULT_OG_IMAGE_WIDTH,
  GA_MEASUREMENT_ID,
  absoluteAssetUrl,
  SITE_ORIGIN,
} from '../config/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteSearch from '../components/SiteSearch.astro';
import SharePage from '../components/SharePage.astro';
import JsonLd from '../components/JsonLd.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  blogSlug?: string;
  blogLocales?: Locale[];
}

const locale = getLocaleFromAstro(Astro);
const t = getTranslations(locale);
const meta = localeMeta[locale];

const {
  title = t.site.title,
  description = t.site.description,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = title,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  noindex = false,
  jsonLd,
  blogSlug,
  blogLocales,
} = Astro.props;

const canonical = canonicalUrl(Astro.url.pathname);
const ogImageUrl = absoluteAssetUrl(ogImage);
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const alternates = getAlternateLanguages(Astro.url.pathname, SITE_ORIGIN, {
  blogSlug,
  blogLocales,
});
const xDefaultHref = alternates.find((a) => a.locale === 'en')?.href ?? canonical;
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir} class="dark fonts-pending">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('colorTheme') || localStorage.getItem('starwind-theme');
          if (stored === 'light') document.documentElement.classList.remove('dark');
          else if (stored === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
        document.documentElement.classList.add('fonts-pending');
      })();
    </script>
    <style is:global>
      ::highlight(search-query) {
        background-color: color-mix(in oklch, #7f3dee 70%, #1e1035 18%);
      }
    </style>
    <style is:inline>
      @media (max-width: 639px) {
        .header-bar__checkout.slide-reveal-btn {
          display: none !important;
        }
      }
      @media (max-width: 1023px) {
        .header-bar__checkout.slide-reveal-btn {
          display: none !important;
        }
      }
      @media (min-width: 768px) {
        .deployment-step-title {
          padding-inline: 0.25rem;
          font-size: 0.75rem;
          white-space: nowrap;
        }
      }
      @media (min-width: 1024px) {
        .deployment-step-title {
          font-size: 0.8125rem;
        }
      }
    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={t.site.name} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="theme-color" content="#7F3DEE" />
    <link rel="canonical" href={canonical} />
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t.site.name} Blog RSS`}
      href={localePath(RSS_FEED_PATH, locale)}
    />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={`${SITE_ORIGIN}/sitemap.xml`} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content={String(DEFAULT_OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(DEFAULT_OG_IMAGE_HEIGHT)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:locale" content={meta.ogLocale} />

    {
      ogType === 'article' && articlePublishedTime && (
        <>
          <meta property="article:published_time" content={articlePublishedTime} />
          <meta
            property="article:modified_time"
            content={articleModifiedTime ?? articlePublishedTime}
          />
          <meta property="article:author" content={t.site.name} />
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {TWITTER_SITE && <meta name="twitter:site" content={TWITTER_SITE} />}
    {TWITTER_CREATOR && <meta name="twitter:creator" content={TWITTER_CREATOR} />}

    <link
      rel="preload"
      href="/fonts/manrope-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/rajdhani-latin-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {jsonLd && <JsonLd data={jsonLd} />}
    <slot name="head" />

  </head>
  <body class="min-h-screen bg-background text-foreground">
    <button type="button" class="skip-link" data-skip-to-main>{t.ui.skipLink}</button>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <SharePage title={title} />
    <Footer />
    <SiteSearch />
    <script>
      import '../scripts/site.ts';
    </script>
    {
      GA_MEASUREMENT_ID && (
        <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
          (() => {
            const loadGa = () => {
              if (window.__gaLoaded) return;
              window.__gaLoaded = true;
              window.dataLayer = window.dataLayer || [];
              function gtag() {
                dataLayer.push(arguments);
              }
              gtag('js', new Date());
              gtag('config', GA_MEASUREMENT_ID, { anonymize_ip: true });
              const s = document.createElement('script');
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
              s.async = true;
              document.head.appendChild(s);
            };
            const onReady = () => {
              if (typeof window.requestIdleCallback === 'function') {
                window.requestIdleCallback(loadGa, { timeout: 4000 });
              } else {
                window.setTimeout(loadGa, 2500);
              }
            };
            if (document.readyState === 'complete') onReady();
            else window.addEventListener('load', onReady, { once: true });
          })();
        </script>
      )
    }
  </body>
</html>
