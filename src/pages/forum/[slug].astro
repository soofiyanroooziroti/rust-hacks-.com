---
import { defaultLocale } from '../../i18n/locales';
import ForumDetailPage from '../../components/forum/ForumDetailPage.astro';
import { forumPosts } from '../../data/forum';

export function getStaticPaths() {
  return forumPosts.map((post) => ({ params: { slug: post.slug } }));
}
---

<ForumDetailPage locale={defaultLocale} slug={Astro.params.slug!} />
