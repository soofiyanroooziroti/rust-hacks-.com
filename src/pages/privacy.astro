---
import { getLocaleFromAstro, getTranslations } from '../i18n';
const locale = getLocaleFromAstro(Astro);
const t = getTranslations(locale);
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolvePageSeo } from '../config/seo';
import LegalPage from '../components/LegalPage.astro';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';

const content = t.legalPages.privacy;
const seo = resolvePageSeo('/privacy/');
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: content.title,
      description: content.description,
      url: '/privacy/',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Privacy Policy', path: '/privacy/' },
    ]),
  ]}
>
  <LegalPage
    title={content.title}
    description={content.description}
    breadcrumbLabel="Privacy Policy"
    sections={content.sections}
  />
</BaseLayout>
