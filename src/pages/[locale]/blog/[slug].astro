---
import '../../../styles/blog-pages.css';
import { getPrefixedBlogStaticPaths } from '../../../data/blog';
import { getBlogLocalesForSlug, getBlogPost, getRelatedBlogPosts } from '../../../data/blog';
import { getTranslations } from '../../../i18n';
import { resolvePageSeo, pageTitle } from '../../../config/seo';
import { articleSchema, breadcrumbSchema, faqPageSchema } from '../../../utils/schema';
import { getBlogPublicationIso } from '../../../data/blog';
import { checkoutPath, resolveCheckoutHref } from '../../../config/checkout';
import { getLocalizedPath, localizedPath, localizedRoutes, normalizeInternalPath } from '../../../utils/path';
import { intrinsicImageSize, socialShareImage } from '../../../utils/responsiveImage';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import BlogSidebar from '../../../components/BlogSidebar.astro';
import BlogPostTopBar from '../../../components/BlogPostTopBar.astro';
import { getBlogFaqs } from '../../../data/faq-locale';
import SiteFaqSection from '../../../components/SiteFaqSection.astro';
import Icon from '../../../components/icons/Icon.astro';
import type { BlogBlock } from '../../../data/blog';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import BlogPostCta from '../../../components/BlogPostCta.astro';

export function getStaticPaths() {
  return getPrefixedBlogStaticPaths().map(({ slug, locale }) => ({
    params: { slug, locale },
  }));
}

const locale = Astro.params.locale!;
const routes = localizedRoutes(locale);
const t = getTranslations(locale);
const { slug } = Astro.params;
const post = getBlogPost(slug!, locale);

if (!post) {
  return Astro.redirect(localizedPath('/blog/', locale));
}

const postPath = getLocalizedPath(`/blog/${post.slug}/`, locale);
const breadcrumbs = [
  { name: t.breadcrumbs.home, path: localizedPath('/', locale) },
  { name: t.breadcrumbs.blog, path: localizedPath('/blog/', locale) },
  { name: post.title, path: postPath },
];

const related = getRelatedBlogPosts(post.slug, 3, locale);
const blogFaqs = getBlogFaqs(post.tag, post.slug, locale);
const blogLocales = getBlogLocalesForSlug(post.slug);

function linkify(text: string): string {
  return text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label: string, href: string) => {
    const normalized = getLocalizedPath(normalizeInternalPath(href), locale);
    return `<a href="${normalized}">${label}</a>`;
  });
}

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}
const published = getBlogPublicationIso(post);
const h1Text = post.h1Title ?? post.title;
---

<BaseLayout
  title={pageTitle(post.seoTitle ?? post.title, null)}
  description={post.desc}
  blogSlug={post.slug}
  blogLocales={blogLocales}
  ogType="article"
  ogImage={socialShareImage(post.image)}
  ogImageAlt={post.imageAlt ?? post.title}
  articlePublishedTime={published}
  articleModifiedTime={published}
  jsonLd={[
    articleSchema({
      name: h1Text,
      description: post.desc,
      url: postPath,
      image: post.image,
      datePublished: published,
    }),
    breadcrumbSchema(breadcrumbs),
    faqPageSchema(
      blogFaqs.map((item, index) => ({
        num: String(index + 1).padStart(2, '0'),
        q: item.q,
        a: (item.aHtml ?? item.a).replace(/<[^>]+>/g, ''),
      })),
    ),
  ]}
>
  <article class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <BlogPostTopBar post={post} class="mt-6" />

      <div class="blog-article__layout mt-4 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(11.5rem,13.5rem)] lg:items-start lg:gap-8 xl:grid-cols-[minmax(0,1fr)_13.5rem]">
        <div id="blog-article-start" class="min-w-0">
          <figure class="blog-article__hero">
            <ResponsiveImage
              src={post.image}
              alt={post.imageAlt ?? post.title}
              width={post.imageWidth ?? 960}
              height={post.imageHeight ?? 540}
              loading="eager"
              fetchPriority="high"
              sizes="(min-width: 768px) 720px, 100vw"
              class="w-full object-cover"
            />
          </figure>
          <div data-blog-reading-article>
            <header class="blog-article__header">
              <h1 class="blog-article__title">{h1Text}</h1>
              <p class="blog-article__lead">{post.desc}</p>
              {
                post.author && (
                  <p class="blog-article__byline">
                    <Icon name="users" size={14} />
                    {post.author}
                  </p>
                )
              }
            </header>

            <Prose class="blog-article__prose prose-headings:scroll-mt-24 max-w-none text-left">
              {post.body.map((block: BlogBlock) => {
                if (block.type === 'h2') {
                  const id = slugify(block.text);
                  return <h2 id={id}>{block.text}</h2>;
                }
                if (block.type === 'h3') {
                  const id = slugify(block.text);
                  return <h3 id={id}>{block.text}</h3>;
                }
                if (block.type === 'ul') {
                  return (
                    <ul>
                      {block.items.map((item) => (
                        <li set:html={linkify(item)} />
                      ))}
                    </ul>
                  );
                }
                if (block.type === 'table') {
                  return (
                    <div class="overflow-x-auto">
                      <table>
                        <thead>
                          <tr>
                            {block.headers.map((header) => (
                              <th>{header}</th>
                            ))}
                          </tr>
                        </thead>
                        <tbody>
                          {block.rows.map((row) => (
                            <tr>
                              {row.map((cell) => (
                                <td set:html={linkify(cell)} />
                              ))}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  );
                }
                if (block.type === 'figure') {
                  return (
                    <figure class="blog-article__inline-figure">
                      <ResponsiveImage
                        src={block.src}
                        alt={block.alt}
                        width={960}
                        height={540}
                        loading="lazy"
                        sizes="(min-width: 768px) 720px, 100vw"
                        class="w-full rounded-lg object-cover"
                      />
                    </figure>
                  );
                }
                if (block.type === 'cta') {
                  return (
                    <BlogPostCta
                      title={block.title}
                      html={linkify(block.text)}
                      href={resolveCheckoutHref(block.href)}
                    />
                  );
                }
                return <p set:html={linkify(block.text)} />;
              })}
            </Prose>
          </div>

          <nav class="blog-article__actions" aria-label="Continue reading">
            <Button
              as="a"
              href={checkoutPath('apexLegends')}
              variant="primary"
              aria-label={t.ui.checkoutAria}
              rel="nofollow sponsored"
              data-astro-reload
              data-astro-prefetch="false"
            >
              {t.pricing.buyNow}
              <Icon name="arrowRight" size={17} />
            </Button>
            <Button as="a" href={routes.products} variant="outline">
              {t.notFound.viewProducts}
            </Button>
            <Button as="a" href={routes.blog} variant="outline">
              {t.blog.viewAll}
              <Icon name="arrowRight" size={17} />
            </Button>
          </nav>
        </div>
        <BlogSidebar post={post} related={related} class="min-w-0" />
      </div>
    </div>
  </article>

  <SiteFaqSection
    items={blogFaqs}
    filterTopics={['all', 'blog', 'plans']}
    titleId={`blog-faq-${post.slug}`}
    class="border-t border-border bg-muted/20"
  />
</BaseLayout>
