---
import { localeOnlyPaths } from '../../../i18n/paths';

export function getStaticPaths() {
  return localeOnlyPaths();
}

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { resolvePageSeo } from '../../../config/seo';
import { getTranslations } from '../../../i18n';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import {
  STATUS_LAST_UPDATED,
  STATUS_LEGEND,
  STATUS_PAGE_INTRO,
  STATUS_RECENT_UPDATES,
  STATUS_STATE_DETAIL,
  STATUS_STATE_LABEL,
  STATUS_TONE,
  formatActiveStatusLine,
  formatStatusUpdated,
} from '../../../data/status';
import { breadcrumbSchema, webPageSchema } from '../../../utils/schema';
import { localizedPath } from '../../../utils/path';

const locale = Astro.params.locale!;
const t = getTranslations(locale);
const statusUi = t.status;

const seo = resolvePageSeo('/status/', locale);
const breadcrumbs = [
  { name: t.breadcrumbs.home, path: localizedPath('/', locale) },
  { name: statusUi.breadcrumb, path: localizedPath('/status/', locale) },
];
const statusLine = formatActiveStatusLine(STATUS_LAST_UPDATED);
const updatedOn = formatStatusUpdated(STATUS_LAST_UPDATED);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  noindex={true}
  jsonLd={[
    webPageSchema({
      name: seo.title,
      description: seo.description,
      url: localizedPath('/status/', locale),
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="status-page border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-6">
        <SectionHeader
          eyebrow="Status"
          title="Rust Hacks status"
          desc={STATUS_PAGE_INTRO}
          titleId="status-page-title"
          heading="h1"
          wide
        />
      </div>

      <article
        class="status-page-card mx-auto mt-10 max-w-2xl overflow-hidden rounded-2xl border border-primary/35 bg-card shadow-md ring-1 ring-primary/15"
        aria-labelledby="status-card-heading"
      >
        <div class="status-page-card__bar h-1 bg-primary/60" aria-hidden="true"></div>
        <div class="space-y-6 px-5 py-6 md:px-7 md:py-7">
          <header class="space-y-4">
            <h2 id="status-card-heading" class="text-lg font-semibold text-foreground">
              Current label
            </h2>
            <p class:list={['status-state', `status-state--${STATUS_TONE}`]}>
              <span class="status-state__mark">{STATUS_STATE_LABEL}</span>
              <span class="status-state__detail">{STATUS_STATE_DETAIL}</span>
            </p>
            <p class="text-sm font-medium text-foreground">{statusLine}</p>
            <p class="text-sm text-muted-foreground">Checked {updatedOn}.</p>
          </header>

          <ul class="status-legend" role="list">
            {
              STATUS_LEGEND.map((item) => (
                <li class:list={['status-legend__item', `status-legend__item--${item.tone}`]}>
                  <span class="status-legend__swatch" aria-hidden="true" />
                  <span>
                    <strong>{item.label}</strong>
                    <span class="text-muted-foreground"> — {item.text}</span>
                  </span>
                </li>
              ))
            }
          </ul>

          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
              {statusUi.recentTitle}
            </h3>
            <ol class="status-page-updates mt-4 space-y-4" role="list">
              {
                STATUS_RECENT_UPDATES.map((entry, i) => (
                  <li class="status-page-updates__item border-l-2 border-primary/35 pl-4">
                    <p class="text-sm font-semibold text-foreground">
                      {entry.title}
                      <span class="font-normal text-muted-foreground"> · {entry.when}</span>
                    </p>
                    <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{entry.summary}</p>
                    {i === 0 ? (
                      <p class="mt-2 text-xs font-medium text-primary/90">{(statusUi as { latestLabel?: string }).latestLabel ?? 'Latest'}</p>
                    ) : null}
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
